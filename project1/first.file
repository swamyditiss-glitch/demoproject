Deb2ip ansible_user=deb2name

save it
expected ping pong

nano setup_apache.yml
        |
---
- name: Update deb2 and install apache2
  hosts: debian_servers
  become: true
  tasks:
   - name: refresh apt
     ansible.builtin.apt:
        update_cache: true
   - name: upgrade install
     ansible.builtin.apt:
        upgrade: yes
   - name: create user
     ansible.builtin.user:
        name: tinku
        group: admin
   - name: install
     ansible.builtin.apt:
        name: tree
        state: present
   - name: install apache2
     ansible.builtin.apt:
        name: apache2
        state: present
 
 save it
 

run in deb1

->ansible-playbook -i inventory.ini setup_apache2.yml 

from this big process starts

to check apache2
